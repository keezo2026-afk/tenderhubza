ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://tenderhub:tenderhub_dev@localhost:5432/tenderhub
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
EXPOSE_DEVELOPMENT_RESET_TOKEN=false
AUTH_RATE_LIMIT_PER_MINUTE=10
CONNECTOR_TIMEOUT_SECONDS=30
CONNECTOR_MAX_ATTEMPTS=3
CONNECTOR_MAX_REDIRECTS=5
ETENDERS_PAGE_SIZE=100
MAIL_ADAPTER=development
ETENDERS_INITIAL_SYNC_DAYS=30
ETENDERS_OVERLAP_DAYS=1
CONNECTOR_SCHEDULE_ENABLED=false
CONNECTOR_SCHEDULE_INTERVAL_MINUTES=60
PUBLIC_APP_URL=tenderhub://reset-password
